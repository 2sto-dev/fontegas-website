# Ignore everything by default so only the project files we need are tracked
*

# Keep the source files we want in Git
!backend/
!backend/**
!frontend/
!frontend/**
!.gitignore
!.env.example

# Ignore build output and local dependency folders
node_modules/
dist/
**/node_modules/
**/dist/

# Ignore secrets and local environment files
.env
.env.*
!.env.example

# Document files required by the database deployment snapshot
!/model-inf-publica.pdf
!/PLAN-DE-URGENTA-INTERNA.doc
!/raport inspectie 23.05.2025.pdf
!/raport-securitate-2020-2.pdf
!/raport-securitate-2020.pdf
!/raport_inspectie.docx
!/raport_inspectie_seveso.pdf
!/svso2026.pdf
